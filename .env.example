# Copie para .env SOMENTE na instalação privada do servidor. Nunca envie valores no chat.
# O Checkout Pro redireciona o cliente; números de cartão não passam por esta aplicação.
MERCADOPAGO_ENABLED=false
MERCADOPAGO_ENVIRONMENT=test
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Origem HTTPS, sem caminho, credenciais, query ou fragmento. Preencha ao publicar.
APP_PUBLIC_URL=
# Em hospedagem HTTPS use NODE_ENV=production para cookies Secure.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# start:operational usa data/operacional.sqlite por padrão.
# QF_DATABASE_PATH=
