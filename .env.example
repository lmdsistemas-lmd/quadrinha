# SaaS de três áreas (npm start). Não envie valores privados no chat.
# Opcional para uso local em 127.0.0.1: deixe vazio. Links de e-mail usam a porta local.
# Checkout e webhooks exigem uma origem HTTPS pública, sem caminho/query, ao publicar.
APP_PUBLIC_URL=
PLATFORM_MODE=production
# Diretório persistente. Padrão: data/platform
# PLATFORM_DATA_DIR=
# 32 bytes em hexadecimal, injetados diretamente no servidor.
# Sem esta variável, preserva a chave privada criada em data/platform/platform.key.
# PLATFORM_ENCRYPTION_KEY=
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Apenas modo standalone (start:standalone / start:operational).
# SaaS configura Mercado Pago por empresa e para a plataforma pela interface.
MERCADOPAGO_ENABLED=false
MERCADOPAGO_ENVIRONMENT=test
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# QF_DATABASE_PATH=
